<?xml version="1.0" encoding="utf-8"?>
<!-- Big connect button with its status texts -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:layout_width="@dimen/connect_frame_size"
        android:layout_height="@dimen/connect_frame_size"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/connect_halo"
            android:layout_width="@dimen/connect_halo_size"
            android:layout_height="@dimen/connect_halo_size"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/bg_connect_halo" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/connect_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="invisible"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="@dimen/connect_progress_size"
            app:trackColor="@android:color/transparent"
            app:trackThickness="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/connect_button"
            android:layout_width="@dimen/connect_button_size"
            android:layout_height="@dimen/connect_button_size"
            android:layout_gravity="center"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:cardCornerRadius="@dimen/connect_button_radius"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorOnSurface"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/connect_icon"
                android:layout_width="@dimen/connect_icon_size"
                android:layout_height="@dimen/connect_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_power"
                app:tint="?attr/colorPrimary" />

        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <TextView
        android:id="@+id/status_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        tools:text="Not connected" />

    <TextView
        android:id="@+id/status_subtitle"
        android:breakStrategy="balanced"
        tools:targetApi="m"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:maxWidth="360dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Tap the button to open blocked websites and apps" />

</LinearLayout>
